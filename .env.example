# URL publik situs (untuk sitemap, Open Graph, dan link berbagi)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API). Tanpa ini, kalkulator tetap jalan; fitur akun nonaktif.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# RAHASIA – hanya di server. Dipakai halaman share /s/[slug] dan script pro:grant.
SUPABASE_SERVICE_ROLE_KEY=

# Alamat untuk tombol "Hubungi kami" di /upgrade
CONTACT_EMAIL=halo@example.com
